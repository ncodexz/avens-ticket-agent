# Copia este archivo a .env y rellena los valores. .env NO se sube a Git.
# Aqui solo van nombres; ningun secreto.

# local | databricks
ENV_MODE=local

# Datos exportados (no se copian al proyecto)
EXPORT_DIR=../export

# Databricks
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=ticket_masters_dev_catalog
COMMON_CATALOG=aiops_participants_synthethic_data
MAPPING_TABLE=ticket_id_mapping_friday

# OpenProject (lectura en la plataforma de Alenia; el Docker local queda apagado)
OPENPROJECT_BASE_URL=
OPENPROJECT_PROJECT=hackathon-ticket-masters
OPENPROJECT_WRITE_ENABLED=false

# Secretos dentro de Databricks (scope y clave; el valor vive en el vault)
OPENPROJECT_SECRET_SCOPE=
OPENPROJECT_SECRET_KEY=
LLM_SECRET_SCOPE=aiops-hackathon
LLM_SECRET_KEY=ai-api-scope-token

# Modelo
LLM_ENDPOINT=
GROQ_API_KEY=
